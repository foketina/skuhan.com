# Skuhan.com Drupal 11 - Environment Variables
# Copy this file to .env and fill in the values
# In Coolify, set these as environment variables in the UI

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Database host (use 'db' for docker-compose, or external host)
DB_HOST=db

# Database port
DB_PORT=3306

# Database name
DB_NAME=drupal

# Database user
DB_USER=drupal

# Database password (REQUIRED - generate a secure password)
DB_PASSWORD=

# Database root password (for initial setup)
DB_ROOT_PASSWORD=

# ===========================================
# DRUPAL CONFIGURATION
# ===========================================

# Hash salt for security (REQUIRED - generate with: openssl rand -hex 32)
DRUPAL_HASH_SALT=

# Trusted host pattern (regex, escape dots with backslash)
# Examples: ^skuhan\.com$, ^www\.skuhan\.com$|^skuhan\.com$
DRUPAL_TRUSTED_HOST=^skuhan\.com$

# ===========================================
# DOMAIN CONFIGURATION (for Traefik)
# ===========================================

# Your domain name (without protocol)
DOMAIN=skuhan.com

# ===========================================
# PHP CONFIGURATION
# ===========================================

# PHP memory limit
PHP_MEMORY_LIMIT=256M

# Maximum upload file size
PHP_UPLOAD_MAX_FILESIZE=64M

# ===========================================
# GENERATE SECRETS
# ===========================================
# Run these commands to generate secure values:
#
# Hash salt:
#   openssl rand -hex 32
#
# Database password:
#   openssl rand -base64 24
#
# Root database password:
#   openssl rand -base64 24
